{
  "name": "uigraph-slack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "dev": "tsx --watch ./src/index.ts",
    "start": "tsx ./src/index.ts"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9",
    "@types/node": "^25.9.5",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-check-file": "^3",
    "eslint-plugin-import": "^2",
    "eslint-plugin-prettier": "^5",
    "husky": "^9",
    "prettier": "^3",
    "prettier-plugin-organize-imports": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@slack/bolt": "^4.7.3",
    "@uigraph/ai-sdk": "^1.0.3",
    "ai": "^7.0.22",
    "consola": "^3.4.2",
    "slackify-markdown": "^5.0.0",
    "zod": "^4.4.3"
  }
}
